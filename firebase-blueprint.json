{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated commuter or auto-rickshaw driver profile verified via Firebase Phone OTP.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Verified 10-digit Indian mobile number in E.164 +91 format.",
          "minLength": 13,
          "maxLength": 13,
          "pattern": "^\\+91[6-9][0-9]{9}$"
        },
        "role": {
          "type": "string",
          "description": "Selected primary operating role.",
          "enum": ["PASSENGER", "DRIVER"]
        },
        "driverAutoRegNumber": {
          "type": "string",
          "description": "Indian RTO auto-rickshaw registration plate (required when role is DRIVER; omitted for PASSENGER).",
          "minLength": 9,
          "maxLength": 11,
          "pattern": "^[A-Z]{2}[0-9]{2}[A-Z]{1,3}[0-9]{4}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set on initial profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp updated when profile is saved."
        }
      },
      "required": ["uid", "phoneNumber", "role", "createdAt", "updatedAt"]
    },
    "ActiveShareAutoRoute": {
      "title": "ActiveShareAutoRoute",
      "description": "Live driver share-auto route posting with station stand location, total booking fare, and 1..3 seat inventory.",
      "type": "object",
      "properties": {
        "postingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "driverUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "driverAutoRegNumber": {
          "type": "string",
          "minLength": 9,
          "maxLength": 11,
          "pattern": "^[A-Z]{2}[0-9]{2}[A-Z]{1,3}[0-9]{4}$"
        },
        "pickupStation": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "pickupSide": {
          "type": "string",
          "enum": ["EAST", "WEST"]
        },
        "designatedStand": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "destination": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "viaPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "totalBookingFare": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "totalCapacitySeats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "availableSeats": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "activeQueueCount": {
          "type": "integer",
          "minimum": 0
        },
        "isActive": {
          "type": "boolean"
        },
        "isLegallyVerified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "postingId",
        "driverUid",
        "pickupStation",
        "pickupSide",
        "designatedStand",
        "destination",
        "viaPoints",
        "totalBookingFare",
        "totalCapacitySeats",
        "availableSeats",
        "activeQueueCount",
        "isActive",
        "isLegallyVerified",
        "createdAt",
        "updatedAt"
      ]
    },
    "SeatLockRecord": {
      "title": "SeatLockRecord",
      "description": "Atomic passenger seat lock written inside a Cloud Firestore transaction to prevent double-booking.",
      "type": "object",
      "properties": {
        "lockId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "postingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "passengerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "driverUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "seatsLocked": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "agreedTotalFare": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "queuePosition": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": ["LOCKED", "RELEASED"]
        },
        "lockedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "lockId",
        "postingId",
        "passengerUid",
        "driverUid",
        "seatsLocked",
        "agreedTotalFare",
        "queuePosition",
        "status",
        "lockedAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Owner-only PII document holding the authenticated user's UID, +91 phone number, role, and Driver auto registration number."
    },
    "/active_routes/{postingId}": {
      "schema": {
        "$ref": "#/entities/ActiveShareAutoRoute"
      },
      "description": "Publicly searchable (signed-in) live share-auto route postings with flat booking fare and atomic 1..3 seat inventory (no phone PII)."
    },
    "/active_routes/{postingId}/seat_locks/{passengerUid}": {
      "schema": {
        "$ref": "#/entities/SeatLockRecord"
      },
      "description": "Real-time queue & atomic seat lock entries created inside Firestore transactions."
    }
  }
}
